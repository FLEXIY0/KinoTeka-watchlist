{
  "name": "films-serials-manager",
  "version": "1.0.0",
  "description": "Система управления фильмами и сериалами",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test test/server.test.js && node ktw/test.js",
    "app": "node scripts/app_launcher.js",
    "build:exe": "pkg scripts/app_launcher.js -t node18-win-x64 -o FilmsManager.exe",
    "build:exe-small": "pkg scripts/app_launcher.js -t node18-win-x64 -o FilmsManager.exe --compress GZip",
    "build:server-exe": "pkg server.js -t node18-win-x64 -o FilmsServer.exe",
    "ktw": "node ktw/ktw.js"
  },
  "bin": {
    "ktw": "ktw/ktw.js",
    "films-manager": "scripts/app_launcher.js"
  },
  "pkg": {
    "assets": [
      "*.html",
      "*.css",
      "*.js",
      "themes/**/*",
      "settings.json",
      "КАК_ИСПОЛЬЗОВАТЬ_ТЕМЫ.txt"
    ],
    "outputPath": "dist"
  },
  "keywords": [
    "films",
    "series",
    "manager",
    "desktop-app"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^2.0.2",
    "figlet": "^1.11.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "pkg": "^5.8.1"
  }
}
